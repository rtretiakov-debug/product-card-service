# Normalize text files and use LF in working trees.
* text=auto eol=lf

# Preserve native line endings for Windows scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary